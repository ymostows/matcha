# Base de données Neon PostgreSQL
DATABASE_URL=postgresql://username:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars

# Serveur
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Email - Mailtrap (recommandé pour la soutenance)
# Crée un compte gratuit sur https://mailtrap.io → Email Testing → Inboxes → SMTP Settings
MAILTRAP_USER=votre_user_mailtrap
MAILTRAP_PASS=votre_pass_mailtrap
# Si MAILTRAP_USER et MAILTRAP_PASS sont vides → fallback automatique sur Ethereal (dev uniquement)

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
