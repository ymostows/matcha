# Configuration pour le développement local
NODE_ENV=development
DATABASE_URL=postgresql://matcha_user:matcha_password@localhost:5433/matcha_db
JWT_SECRET=matcha-dev-secret-key-for-school-project-only
PORT=3001
FRONTEND_URL=http://localhost:5173

# Email configuration (optionnel pour développement)
EMAIL_SERVICE=gmail
EMAIL_USER=dev@matcha.local
EMAIL_PASSWORD=dev-password
